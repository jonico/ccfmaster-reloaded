<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.collabnet.ccf.ccfmaster</groupId>
	<artifactId>CCFMaster</artifactId>
	<packaging>war</packaging>
	<version>0.1.0.BUILD-SNAPSHOT</version>
	<name>CCFMaster</name>
	<properties>
		<roo.version>1.1.3.RELEASE</roo.version>
		<spring.version>6.2.19</spring.version>
		<spring-security.version>6.5.11</spring-security.version>
		<spring-webflow.version>3.0.2</spring-webflow.version>
		<hibernate.version>6.6.56.Final</hibernate.version>
		<hibernate-validator.version>8.0.5.Final</hibernate-validator.version>
		<aspectj.version>1.9.25.1</aspectj.version>
		<slf4j.version>2.0.17</slf4j.version>
		<logback.version>1.5.18</logback.version>
		<jackson.version>2.18.3</jackson.version>
		<junit.jupiter.version>5.11.4</junit.jupiter.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.release>25</java.release>
		<skipUnitTests>false</skipUnitTests>
		<!--
			Selenium is deliberately left at 2.37.0. The three *SystemTest suites drive
			com.thoughtworks.selenium (Selenium RC), which was deleted in Selenium 3, so any
			upgrade would mean rewriting them rather than migrating them. They are excluded from
			surefire at the baseline and only have to keep compiling.
		-->
		<selenium.version>2.37.0</selenium.version>
	</properties>
	<!--
		Five of the eight repositories the recovered POM declared are dead
		(maven.springframework.org release + milestone, spring-roo-repository,
		ccf.open.collab.net/mvnrepo, download.java.net/maven/2) and every artifact that is
		still obtainable is on Maven Central. All three pluginRepositories were dead too, so
		the whole block is gone.
	-->
	<repositories>
		<repository>
			<id>JBoss Repo</id>
			<url>https://repository.jboss.org/nexus/content/repositories/releases</url>
			<name>JBoss Repo</name>
		</repository>
	</repositories>
	<dependencyManagement>
		<dependencies>
			<!-- selenium-java 2.37 drags in guava 15; pin the whole graph to one version -->
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava</artifactId>
				<version>33.4.0-jre</version>
			</dependency>
			<dependency>
				<groupId>xml-apis</groupId>
				<artifactId>xml-apis</artifactId>
				<version>1.4.01</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<!-- ============================ test platform ============================ -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.jupiter.version}</version>
			<scope>test</scope>
		</dependency>
		<!--
			junit:junit and the vintage engine stay on the test classpath for the Selenium
			system tests: SeleniumSuite is a custom org.junit.runners.Suite Runner, and JUnit 5
			has no Runner concept to port it to. They are excluded from surefire at the
			baseline and only have to keep compiling.
		-->
		<dependency>
			<groupId>org.junit.vintage</groupId>
			<artifactId>junit-vintage-engine</artifactId>
			<version>${junit.jupiter.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.hamcrest</groupId>
			<artifactId>hamcrest</artifactId>
			<version>2.2</version>
			<scope>test</scope>
		</dependency>
		<!--
			org.springframework.mock.staticmock, carved out of spring-aspects 3.2.18.RELEASE.
			Spring 4.0 deleted the package and nothing replaced it; nine Roo-generated entity
			tests are built on it. See legacy/bootstrap.sh, and
			src/test/java/org/springframework/mock/staticmock/ for the one class that had to be
			recompiled from source rather than reused as bytecode.
		-->
		<dependency>
			<groupId>com.collabnet.ccf.ccfmaster.legacy</groupId>
			<artifactId>spring-mock-staticmock</artifactId>
			<version>3.2.18.RELEASE</version>
			<scope>test</scope>
		</dependency>
		<!--
			jmockit is deliberately left at 0.999.4. 1.x deleted mockit.Mockit and
			@MockClass, which is the whole API these five test classes use, so an upgrade is a
			rewrite. Six of the twelve pre-existing baseline failures are these tests failing
			on a modern JDK (legacy/README.md); they still compile and still fail the same way.
		-->
		<dependency>
			<groupId>mockit</groupId>
			<artifactId>jmockit</artifactId>
			<version>0.999.4</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-java</artifactId>
			<version>${selenium.version}</version>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<artifactId>commons-logging</artifactId>
					<groupId>commons-logging</groupId>
				</exclusion>
				<!-- same java.xml split-package problem as axis-jaxrpc, on the test classpath -->
				<exclusion>
					<artifactId>xml-apis</artifactId>
					<groupId>xml-apis</groupId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-support</artifactId>
			<version>${selenium.version}</version>
			<type>pom</type>
			<scope>test</scope>
		</dependency>

		<!-- ============================== logging =============================== -->
