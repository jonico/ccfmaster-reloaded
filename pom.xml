		</dependency>
		<!--
			dom4j and commons-collections used to arrive transitively (through hibernate-core
			3.5 and tiles/commons-digester respectively). Hibernate 6 no longer uses dom4j and
			the Tiles stack is gone, but the sources import both directly, so they are declared
			here. dom4j moves to the org.dom4j groupId at 2.x.
		-->
		<dependency>
			<groupId>org.dom4j</groupId>
			<artifactId>dom4j</artifactId>
			<version>2.1.4</version>
		</dependency>
		<dependency>
			<groupId>commons-collections</groupId>
			<artifactId>commons-collections</artifactId>
			<version>3.2.2</version>
		</dependency>
		<dependency>
			<groupId>jaxen</groupId>
			<artifactId>jaxen</artifactId>
			<version>1.2.0</version>
		</dependency>
		<dependency>
			<groupId>joda-time</groupId>
			<artifactId>joda-time</artifactId>
			<version>2.13.0</version>
		</dependency>
	</dependencies>

	<build>
		<finalName>${project.artifactId}</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.4.0</version>
				<configuration>
          		<webResources>
            		<resource>
             			<directory>${basedir}/src/main/java/com/collabnet/ccf/core/utils</directory>
             	     	<includes>
               				 <include>**/ccf.png</include>
             			</includes>
             		     <targetPath>WEB-INF/classes/com/collabnet/ccf/core/utils</targetPath>
           			</resource>
         		</webResources>
        		</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<executions>
					<!-- ajc compiles the .java sources as well as the .aj ITDs; javac cannot
					     see aspect types (e.g. ConfigSavingAspect) and fails on them. -->
					<execution><id>default-compile</id><phase>none</phase></execution>
					<execution><id>default-testCompile</id><phase>none</phase></execution>
				</executions>
				<configuration>
					<release>${java.release}</release>
				</configuration>
			</plugin>
			<plugin>
				<groupId>dev.aspectj</groupId>
				<artifactId>aspectj-maven-plugin</artifactId>
				<version>1.14.1</version>
				<dependencies>
					<!-- NB: You must use Maven 2.0.9 or above or these are ignored (see 
						MNG-2972) -->
					<dependency>
						<groupId>org.aspectj</groupId>
						<artifactId>aspectjrt</artifactId>
						<version>${aspectj.version}</version>
					</dependency>
					<dependency>
						<groupId>org.aspectj</groupId>
						<artifactId>aspectjtools</artifactId>
						<version>${aspectj.version}</version>
					</dependency>
				</dependencies>
				<executions>
					<execution>
						<id>aspectj-compile</id>
						<phase>compile</phase>
						<goals><goal>compile</goal></goals>
					</execution>
					<execution>
						<id>aspectj-test-compile</id>
						<phase>test-compile</phase>
						<goals><goal>test-compile</goal></goals>
						<configuration>
							<aspectLibraries>
								<aspectLibrary>
									<groupId>org.springframework</groupId>
									<artifactId>spring-aspects</artifactId>
								</aspectLibrary>
								<!-- holds the abstract AbstractMethodMockingControl aspect that
								     AnnotationDrivenStaticEntityMockingControl extends -->
								<aspectLibrary>
									<groupId>com.collabnet.ccf.ccfmaster.legacy</groupId>
									<artifactId>spring-mock-staticmock</artifactId>
								</aspectLibrary>
							</aspectLibraries>
						</configuration>
					</execution>
				</executions>
				<configuration>
					<outxml>true</outxml>
					<aspectLibraries>
						<aspectLibrary>
							<groupId>org.springframework</groupId>
							<artifactId>spring-aspects</artifactId>
						</aspectLibrary>
					</aspectLibraries>
					<complianceLevel>${java.release}</complianceLevel>
					<source>${java.release}</source>
					<target>${java.release}</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<configuration>
					<encoding>UTF-8</encoding>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.2</version>
				<configuration>
					<excludes>
						<!-- unchanged from the baseline: Roo ITDs are not test classes, and the
						     Selenium system tests need a browser and a deployed server -->
						<exclude>**/*_Roo_*</exclude>
						<exclude>**/*SystemTest*</exclude>
					</excludes>
					<skipTests>${skipUnitTests}</skipTests>
					<!-- forkMode=always was removed in surefire 3; this is its replacement -->
					<forkCount>1</forkCount>
					<reuseForks>false</reuseForks>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>3.7.1</version>
				<configuration>
					<descriptorRefs>
						<descriptorRef>jar-with-dependencies</descriptorRef>
					</descriptorRefs>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>3.1.3</version>
			</plugin>
			<!--
				cobertura-maven-plugin 2.5.1 replaced by JaCoCo. Cobertura instruments with an
				ASM that cannot read class files newer than major 50, so it cannot run on any
				JDK past 8, and the project is dead. Its `clean` goal was also bound into the
				lifecycle, which made `mvn clean` fail outright once the plugin could not be
				resolved.
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<configuration>
					<excludes>
						<exclude>**/*_Roo_*</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals><goal>prepare-agent</goal></goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals><goal>report</goal></goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>3.5.2</version>
				<executions>
					<execution>
						<id>integration-test</id>
						<goals>
							<goal>integration-test</goal>
						</goals>
					</execution>
					<execution>
						<id>verify</id>
						<goals>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<profiles>

		<!-- from http://jira.codehaus.org/browse/MCOBERTURA-86#comment-250278 -->
		<!--
			The buildWithIntegrationTestCoverage profile is gone. It combined
			cobertura4it-maven-plugin 1.0 (a Sonatype plugin last released in 2010, on top of
			Cobertura, which cannot instrument class files newer than major 50) with
			jetty-maven-plugin 7.1.2, a Servlet 2.5 container. Neither can be pointed at
			anything on this stack, and there is no drop-in replacement for the pair - JaCoCo's
			prepare-agent-integration goal plus a Servlet 6 container would be a new profile,
			not a migrated one.
		-->
		<!--
			The buildRunnableWar profile is gone: jetty-console-maven-plugin 1.23 came from
			opensource.kantega.no, which no longer exists, and it embeds a Servlet 2.5 Jetty.
		-->
		<!-- Creating profile to build Generic participant needed implementation as jar -->
		<profile>
			<id>buildGenericParticipantJar</id>
			<activation>
				<property>
					<name>buildGenericParticipantJar</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-jar-plugin</artifactId>
						<version>3.4.2</version>
						<executions>
							<execution>
					        <id>genericParticipant</id>
					        <goals>
					        	<goal>jar</goal>
					        </goals>
					        <phase>package</phase>
					        <configuration>
					          <classifier>GenericParticipant</classifier>
					          <includes>
					            <include>com/collabnet/ccf/ccfmaster/gp/**/*</include>
					            <include>com/collabnet/ccf/ccfmaster/server/domain/CCFCoreProperty*</include>
					            <include>com/collabnet/ccf/ccfmaster/server/domain/CCFCorePropertyType*</include>
					            <include>com/collabnet/ccf/ccfmaster/server/domain/SystemKind*</include>
					            <include>com/collabnet/ccf/ccfmaster/server/domain/Directions*</include>
					            <include>com/collabnet/ccf/ccfmaster/server/domain/ConflictResolutionPolicy*</include>
					            <include>com/collabnet/ccf/core/utils/ValidatorUtils*</include>
					            <include>com/collabnet/ccf/core/utils/ConfigItemValidatorUtils*</include>
					            <include> com/collabnet/ccf/ccfmaster/util/Obfuscator*</include>
					          </includes>
					          <excludes>
						          <exclude>com/collabnet/ccf/ccfmaster/gp/controller/**/*</exclude>
					          </excludes>
					        </configuration>
					      </execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
